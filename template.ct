      <Options moHideChildren="1"/>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>9104</ID>
          <Description>"======= [Script Template/Code Library] ======="</Description>
          <Color>FF8000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>========================================
===== Fast Alloc
========================================
//------- Common variables -------
[ENABLE]
alloc(_Base,8)        //Always 8 bytes
registersymbol(_Base)
alloc(_Mult,8)
registersymbol(_Mult)

_Mult:
dd 7

[DISABLE]
unregistersymbol(*)
dealloc(*)

//------- Set variable to register -------
alloc(_Set,8)        //8 bytes
_Set:
dq (double)?
dd (float)?

movsd xmm?,[_Set]
movss xmm?,[_Set]

========================================
===== Code Save / Readmem
========================================
//------- Generic code saver -------
alloc(_CodeSave,Size)
_CodeSave:
  readmem(TargetCode,Size)
registersymbol(_CodeSave)

unregistersymbol(_CodeSave)
dealloc(_CodeSave)

//------- Add max to current -------
  push rdi
  lea rdi,[rax+current_offset]
  movss xmm0,[rdi+max_offset_difference]
  movss [rdi],xmm0
  pop rdi
//Convert all to db bytes after writing
========================================
===== Handle Jump Instructions In Region
========================================
[ENABLE]
//------- For short jump -------
  jcd return+?
  jmp return+?
  //Recalculate the value relative to return &amp; original range

//------- For far jump -------
label(FarJumpHelper)

jcd FarJumpHelper  //jmp conditioned

FarJumpHelper:
  jmp return+?     //recalculate the original range

========================================
===== XMMs Handling
========================================
//------- Modify xmms register -------
  push (float)x
  fld [rsp]
  movss xmm?,[rsp]
  fstp st(0)
  add rsp,8
  //Convert xmms Float to Double and vice versa
  cvtss2sd xmm?,xmm?   //float to double
  cvtsd2ss xmm?,xmm?   //double to float

//------- Modify Double data -------
  push #x  //(int)
  fild [rsp]
  fstp qword ptr [rax+??]
  add rsp,8

  //for 32-bit games
  push #x      //(int)
  fild [esp]
  fstp qword ptr [eax+??]
  add esp,4
//------- Clear Register/Set Register = 0 -------
  xor rax,rax
  xorps xmm?,xmm?

  fldz //Load 0 to stack
  fld1 //Load 1.0 to stack

//------- Push &amp; Pop preserve xmms register -------
//push
  sub esp,10
  movdqu [esp],xmm?
//pop
  movdqu xmm?,[esp]
  add esp,10

//------- Compare xmms register -------
  comiss xmm?,xmm?
  comiss xmm?,[rax+?]
  ucomiss xmm?,xmm?
  ucomiss xmm?,[rax+?]

  jl, jg will not work - use jb, ja instead

//------- Check Negative Value -------
alloc(Zero,4)         // if registers aren't free and must be preserved
//double value xmm
  ucomisd xmm?,xmm15  // make sure xmm15 is always 0
  jae code
  comisd xmm0,[Zero]  // compare xmm0 with 0
  ja code             // jump to code if xmm0 is negative
//float value xmm
  ucomiss xmm?,xmm15  // make sure xmm15 is always 0
  jae code
  comiss xmm0,[Zero]  // compare xmm0 with 0
  ja code             // jump to code if xmm0 is negative
//int register
  cmp eax, 0          // compare eax to 0
  jns my_label        // jump to my_label if eax is not negative
  cmp rax, 0          // compare rax to 0
  js code             // jump to code if rax is negative

========================================
===== In case of crash
========================================
//=== Common fixes ===
//--- Mainly for uncontrollable multilevel pointers
  test r??,r??
  je code

Example:
  test rdi,rdi
  je code

//=== Try, Except ===
//--- For everything that caused a crash
newmem:
  push ??
{$try}
  // your code here
{$except}
code:
  pop ??

//=== Call Is Bad Read Pointer ===
call IsBadReadPtr
cmp eax,00
jnz code

========================================
===== Miscellaneous
========================================
  //Complex Breakpoint Condition
  return (RAX &gt;= 0x6e) or (RBX &lt;=0x5f)

  //Convert int to float
  cvtsi2ss xmm7,[rax+4]

  //Convert float to int
  cvttss2si rax,[rax+00000004]

  //Get Unity il2cpp name
  print(getNameFromAddress('Address', true, true, true))
  print(getNameFromAddress(Address, false, false, true))

  //Complex conditioned breakpoint
  if RSP~=0x0000001BD3EEE6E8 and RSP~=0x0000001BD3EEE4D8 then
      return 1
  else

  end
  //Read value in hex of the pointer in register
  readInteger(EDX)==0x?  --//4 bytes
  bAnd(readInteger(EDX),0xff)==0x?  --//1 byte
  -- is comment in lua

================================================================================
===== For Unity Engine
================================================================================
//=== Activation for GameAssembly.dll ===
{$lua}
if syntaxcheck then
    return
end
if (process ~= nil) then
  if not loadingmono then
    loadingmono=true
    LaunchMonoDataCollector()
  end
  while not monoSymbolList do sleep(10) end --monoSymbolList could be nil
  while not monoSymbolList.FullyLoaded do sleep(10) end
end
{$asm}

================================================================================
===== For Unreal Engine
================================================================================
