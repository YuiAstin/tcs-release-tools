          <AssemblerScript>========================================
===== Common Script wFlag
========================================
[ENABLE]
alloc(_Flag,4)
registersymbol(_Flag)

_Flag:
dd 0

newmem:
  cmp [_Flag],1
  jne @f

@@:

code:

[DISABLE]
unregistersymbol(_Flag)
dealloc(_Flag)

========================================
===== "Get Money Data" Script
========================================
//--- Unlimited Money &amp; Dynamic Pointer ---
[ENABLE]
alloc(Money_Edit,8)
registersymbol(Money_Edit)
alloc(Money_Flag,4)
registersymbol(Money_Flag)

Money_Flag:
dd 0

alloc(Money_CodeSave,Size)
Money_CodeSave:
  readmem(TargetCode,Size)
registersymbol(Money_CodeSave)

newmem:
  push rdi
  lea rdi,[+x]
  mov [Money_Edit],rdi
  cmp [Money_Flag],1
  jne @f
  mov [rdi],#777777777  //(float)777777777
code:
  pop rdi

[DISABLE]
unregistersymbol(*)
dealloc(*)

========================================
===== "Get HP Data" Script
========================================
//--- God Mode &amp; Instant Kill ---
[ENABLE]
label(GodMode)
label(InstantKill)

registersymbol(GodMode_Flag)
registersymbol(InstantKill_Flag)
registersymbol(Damage_Mult)
alloc(GodMode_Flag,4)
alloc(InstantKill_Flag,4)
alloc(Damage_Mult,4)

GodMode_Flag:
dd 0
InstantKill_Flag:
dd 0
Damage_Mult:
dd 0

newmem:
  cmp dword ptr [rax+000000xx],1  //check is Player
  je @f  //jmp if player

  cmp dword ptr [InstantKill_Flag],1
  je InstantKill

/*_remove_this_line_
  cmp [Damage_Mult],0
  je code
  imul damage_register,[Damage_Mult]
  mulss damage_register,[Damage_Mult]
_remove_this_line_*/

  jmp code
@@:
  cmp dword ptr [GodMode_Flag],1
  je GodMode

//----------------------------
code: //Place below code

GodMode:

  jmp code/return
InstantKill:

  jmp code/return

[DISABLE]
unregistersymbol(*)
dealloc(*)


registersymbol(InstantKill_Flag)
registersymbol(Damage_Mult)
alloc(InstantKill_Flag,4)
alloc(Damage_Mult,4)

========================================
===== "Get Enemy HP Data" Script
========================================
//--- Standalone Instant Kill &amp; Damage Multiplier ---
[ENABLE]
registersymbol(InstantKill_Flag)
registersymbol(Damage_Mult)
alloc(InstantKill_Flag,4)
alloc(Damage_Mult,4)

InstantKill_Flag:
dd 0
Damage_Mult:
dd 0

newmem:
  cmp [Damage_Mult],0
  je @f
  imul rax,[Damage_Mult]
  mulss xmm0,[Damage_Mult]
@@:
  cmp dword ptr [InstantKill_Flag],1
  jne @f
  //Kill code

code:

[DISABLE]
unregistersymbol(*)
dealloc(*)
